{
  "expo": {
    "name": "dotHealth",
    "slug": "dothealth",
    "version": "v1.1.3",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.dotextension.dothealth",
      "versionCode": 24
    },
    "extra": {
      "eas": {
        "projectId": "91506c8f-974f-4454-a623-f2063080f2f1"
      }
    },
    "owner": "renanmakoto",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
